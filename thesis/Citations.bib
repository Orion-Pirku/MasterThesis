  month = dec,
  year = {2017},
  keywords = {Meiosis, Recombination, CXXC1, IHO1, PRDM9 KRAB domain, Protein
              interactions},
  pages = {681--695},
  file = {Full Text PDF:/Users/orionpirku/Zotero/storage/UVJC98RN/Imai et al. -
          2017 - The PRDM9 KRAB domain is required for meiosis and
          .pdf:application/pdf},
}

@article{quinlan_bedtools_2010,
