@article{smagulova_evolutionary_2016,
  title = {The evolutionary turnover of recombination hot spots contributes to
           speciation in mice},
  volume = {30},
  issn = {0890-9369, 1549-5477},
  url = {http://genesdev.cshlp.org/content/30/3/266},
  doi = {10.1101/gad.270009.115},
  abstract = {Meiotic recombination is required for the segregation of
              homologous chromosomes and is essential for fertility. In most
              mammals, the DNA double-strand breaks (DSBs) that initiate meiotic
              recombination are directed to a subset of genomic loci (hot spots)
              by sequence-specific binding of the PRDM9 protein. Rapid evolution
              of the DNA-binding specificity of PRDM9 and gradual erosion of
              PRDM9-binding sites by gene conversion will alter the recombination
              landscape over time. To better understand the evolutionary turnover
              of recombination hot spots and its consequences, we mapped DSB hot
              spots in four major subspecies of Mus musculus with different Prdm9
              alleles and in their F1 hybrids. We found that hot spot erosion
              governs the preferential usage of some Prdm9 alleles over others in
              hybrid mice and increases sequence diversity specifically at hot
              spots that become active in the hybrids. As crossovers are
              disfavored at such hot spots, we propose that sequence divergence
              generated by hot spot turnover may create an impediment for
              recombination in hybrids, potentially leading to reduced fertility
              and, eventually, speciation.},
  language = {en},
  number = {3},
  urldate = {2024-01-26},
  journal = {Genes \& Development},
  author = {Smagulova, Fatima and Brick, Kevin and Pu, Yongmei and
            Camerini-Otero, R. Daniel and Petukhova, Galina V.},
  month = jan,
  year = {2016},
  pmid = {26833728},
  note = {Company: Cold Spring Harbor Laboratory Press Distributor: Cold Spring
          Harbor Laboratory Press Institution: Cold Spring Harbor Laboratory
          Press Label: Cold Spring Harbor Laboratory Press Publisher: Cold Spring
          Harbor Lab},
  keywords = {meiosis, Prdm9, DSB hot spots, homologous recombination, hybrid
              sterility, recombination hot spots, speciation},
  pages = {266--280},
  file = {Full Text PDF:/Users/orionpirku/Zotero/storage/2H6HQ6IN/Smagulova et
          al. - 2016 - The evolutionary turnover of recombination hot
          spo.pdf:application/pdf},
}

