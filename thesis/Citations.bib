            and Baarends, Willy M.},
  month = apr,
  year = {2015},
  keywords = {Meiosis, Spermatogenesis, Spermatocytes, DNA double-strand break
              repair, Dog, Meiotic sex chromosome inactivation, MSCI, Sex
              chromosomes, Spermatids, Synaptonemal complex, Transcriptome},
  pages = {291},
  file = {Full Text PDF:/Users/orionpirku/Zotero/storage/L7EDANV4/Federici et
          al. - 2015 - Incomplete meiotic sex chromosome inactivation in
          .pdf:application/pdf;Snapshot:/Users/orionpirku/Zotero/storage/6A7I9RE6/s12864-015-1501-9.html:text/html
          },
}

@article{pigozzi_chromosomes_2016,
  title = {The {Chromosomes} of {Birds} during {Meiosis}},
  volume = {150},
  issn = {1424-8581},
  url = {https://doi.org/10.1159/000453541},
  doi = {10.1159/000453541},
  abstract = {The cytological analysis of meiotic chromosomes is an exceptional
              tool to approach complex processes such as synapsis and
              recombination during the division. Chromosome studies of meiosis
              have been especially valuable in birds, where naturally occurring
              mutants or experimental knock-out animals are not available to
              fully investigate the basic mechanisms of major meiotic events.
              This review highlights the main contributions of synaptonemal
              complex and lampbrush chromosome research to the current knowledge
              of avian meiosis, with special emphasis on the organization of
              chromosomes during prophase I, the impact of chromosome
              rearrangements during meiosis, and distinctive features of the ZW
              pair.},
  number = {2},
  urldate = {2024-11-04},
